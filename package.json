{
  "name": "ametller-origen-skill",
  "version": "0.5.3",
  "description": "Ametller Origen skill, MCP, purchase analytics, and backtested basket suggestions without checkout.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Denis Moskalets",
    "url": "https://github.com/denya"
  },
  "homepage": "https://github.com/denya/ametller-origen-skill",
  "repository": {
    "type": "git",
    "url": "https://github.com/denya/ametller-origen-skill.git"
  },
  "keywords": [
    "ametller",
    "ametller-origen",
    "grocery",
    "groceries",
    "shopping",
    "supermarket",
    "cart",
    "reorder",
    "catalonia",
    "spain",
    "mcp",
    "claude",
    "claude-desktop"
  ],
  "scripts": {
    "cli": "node scripts/cli.mjs",
    "tickets:sync": "python3 scripts/sync_gmail_tickets.py",
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "verify": "npm test && npm run test:mcp && npm run test:login-wiring && npm run validate:plugin && npm run validate:mcpb && npm audit",
    "spike": "node scripts/spike.mjs",
    "login": "node scripts/login.mjs",
    "test:login-wiring": "npm run build && node scripts/test-login-wiring.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test:mcp": "npm run build && node scripts/test-mcp.mjs",
    "test:mcp:live": "npm run build && AMETLLER_LIVE_SMOKE=1 node scripts/test-mcp.mjs",
    "e2e:cart": "node scripts/e2e-cart.mjs",
    "e2e:readonly": "node scripts/e2e-readonly.mjs",
    "validate:plugin": "claude plugin validate . --strict",
    "validate:mcpb": "npx --yes @anthropic-ai/mcpb@2.1.2 validate manifest.json",
    "pack:mcpb": "npm run build && npx --yes @anthropic-ai/mcpb@2.1.2 pack . dist/ametller-origen-0.5.3.mcpb",
    "icon": "python3 scripts/make-icon.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright-core": "^1.61.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
